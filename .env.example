# ──────────────────────────────────────────────────────────────
# DockerForge environment configuration
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored — never commit real secrets.
# ──────────────────────────────────────────────────────────────

# --- LLM provider ---
# Option A: Direct Google Gemini (default)
#   Get a key at https://aistudio.google.com/apikey
#   Leave GEMINI_BASE_URL empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=

# Option B: OpenRouter (use when direct Gemini quota is exhausted, e.g. India free tier)
#   Get a key at https://openrouter.ai/settings/keys
#   Uncomment and fill in:
# GEMINI_API_KEY=sk-or-v1-...
# GEMINI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GEMINI_BASE_URL=https://openrouter.ai/api/v1

# --- Backend server ---
# Comma-separated list of origins allowed to call the API (the frontend dev URL).
CORS_ORIGINS=http://localhost:5173

# --- Agent guardrails ---
CLONE_TIMEOUT_SECONDS=60
MAX_REPO_MB=200
BUILD_TIMEOUT_SECONDS=600
RUN_TIMEOUT_SECONDS=60
MAX_BUILD_ATTEMPTS=3

# --- Container resource limits (applied to each spawned container) ---
CONTAINER_MEMORY=256m
CONTAINER_CPUS=0.5

# --- Docker compose (self-hosted stack only) ---
# GID of the 'docker' group on the host — required for the backend container
# to access /var/run/docker.sock.  Find it with:
#   getent group docker | cut -d: -f3
DOCKER_GID=999

# --- Frontend (Vite dev server only) ---
# In the Docker stack, the browser calls /api/* on its own origin and nginx
# proxies to the backend — no value needed here.
VITE_API_BASE_URL=http://localhost:8000
